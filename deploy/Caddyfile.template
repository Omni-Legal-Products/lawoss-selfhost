# Template for /opt/lawoss/Caddyfile, rendered by the setup CLI:
#   AUTH_HOST     is replaced by auth.<base>;
#   SERVICE_HOST  is replaced by <id>.<base>, and the section between the SERVICES markers is
#                 written once per enabled service.
# Every site gets its own automatic certificate. Caddy passes the Host header to the upstream
# unchanged: the hub routes by Host, the resource-server adapter checks it, and auth answers only
# its own host. Caddy sets the forwarding headers itself and does not trust client-sent ones.

{{AUTH_HOST}} {
	reverse_proxy auth:3000
}

# {{#SERVICES}}
{{SERVICE_HOST}} {
	reverse_proxy hub:3000
}
# {{/SERVICES}}
