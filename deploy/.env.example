# Example only. Copy to deploy/.env (mode 0600) and replace every placeholder.
# Never commit the real file.

# Path inside the container to the authorization server's JSON configuration
# (origin, dataDir, cookieKeys, jwks, resources, optional brand). Generated by the setup CLI
# in a later release. Its optional "brand" field selects a brand pack directory; without it
# the default LAWOSS pack is used.
AUTH_CONFIG=/run/secrets/auth-config.json

# Host name of the login, used by the Compose file of a later release.
AUTH_PUBLIC_HOST=auth.example.com

PORT=3000
